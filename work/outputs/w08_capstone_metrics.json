      "reason_code": "high_traffic_falling_within_month",
      "condition": "impressions at least 500 and mom_impr below 0.8"
    },
    {
      "archetype": "5 stale_but_visible",
      "action": "queue_for_refresh",
      "reason_code": "aged_visible_and_flat_or_down",
      "condition": "age at least 90 days and mom_impr below 1.0"
    },
    {
      "archetype": "6 position_stuck",
      "action": "on_page_optimisation",
      "reason_code": "ranks_just_off_first_page",
      "condition": "average position between 11.0 and 25.0"
    },
    {
      "archetype": "7 ctr_gap",
      "action": "title_snippet_review",
      "reason_code": "visible_but_low_click_share",
      "condition": "average position at most 10 and ctr below 0.15 percent"
    },
    {
      "archetype": "8 young_climbing",
      "action": "monitor_only",
      "reason_code": "too_young_to_judge",
      "condition": "age below 90 days and mom_impr at least 1.0"
    },
    {
      "archetype": "9 steady",
      "action": "no_action",
      "reason_code": "no_trigger_matched",
      "condition": "no earlier condition matched"
    }
  ],
